# DFAB ERP - Supabase environment template
# Copy this file to `.env` and replace the placeholders.
# Browser frontend: use only the Supabase Publishable key (or legacy anon key).
# Never put a secret/service_role key in any VITE_* variable.

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
