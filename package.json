{
  "name": "dfab-erp-home",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit --allowJs --checkJs --target es2022 --module esnext --lib es2022,dom src/erp-utils.js",
    "test": "node --test tests/*.test.js",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:browser": "node tests/browser-smoke.mjs && node tests/browser-advanced.mjs && node tests/browser-premium.mjs",
    "test:premium": "node tests/browser-premium.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "globals": "16.5.0",
    "playwright": "1.62.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
